# LLM provider: auto | gemini | claude_cli | stub
#   auto       -> gemini if GEMINI_API_KEY set, else local `claude` CLI if present, else stub
#   claude_cli -> dev-time, real prompt-aware specs via the local Claude Code CLI (no API key)
#   stub       -> deterministic, offline, template-based
LLM_PROVIDER=auto

# Claude CLI provider (dev)
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_MODEL=sonnet

# Gemini — leave GEMINI_API_KEY empty unless LLM_PROVIDER=gemini (production).
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_SPEC_MODEL=gemini-2.5-flash
GEMINI_SPEC_MODEL_FALLBACK=gemini-2.5-pro

# Infra
REDIS_URL=redis://localhost:6379
OUTPUT_DIR=outputs

# Limits
MAX_PROMPT_CHARS=2000
MAX_UPLOAD_IMAGE_MB=10
